<UserControl x:Class="WC4SaveEditor.Gui.Views.ConquerProvincePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WC4SaveEditor.Gui.Controls">
    <StackPanel>
        <TextBlock Text="Conquer province" Style="{StaticResource SectionHeader}"
                    ToolTip="Conquer Province — click a target to pick specific provinces to annex from them, instead of the whole country."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Annex from (click one)" Style="{StaticResource TextBodyEmphasis}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Annexers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:CountryCard CardData="{Binding}" IsSelected="{Binding IsSelected}"
                                                   MouseLeftButtonUp="Annexer_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Click a target to pick its provinces" Style="{StaticResource TextBodyEmphasis}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MouseLeftButtonUp="Target_Click" Cursor="Hand" IsEnabled="{Binding IsSelectable}"
                                  Opacity="{Binding IsSelectable, Converter={StaticResource BoolToOpacityConverter}}">
                                <controls:CountryCard CardData="{Binding Card}"/>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="6,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                        Visibility="{Binding BadgeCount, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BadgeCount}" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource AccentTextBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
