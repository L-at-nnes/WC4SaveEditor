<UserControl x:Class="WC4SaveEditor.Gui.Views.ConquerPlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WC4SaveEditor.Gui.Controls">
    <StackPanel>
        <TextBlock Text="Conquer player" Style="{StaticResource SectionHeader}"
                    ToolTip="Conquer Player — transfers every tile, unit and landmine of the chosen target player(s) to the annexer."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Annex from (click one)" Style="{StaticResource TextBodyEmphasis}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Annexers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:CountryCard CardData="{Binding}" IsSelected="{Binding IsSelected}"
                                                   MouseLeftButtonUp="Annexer_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Click to annex these players" Style="{StaticResource TextBodyEmphasis}"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                            Visibility="{Binding CheckedCount, Converter={StaticResource CountToVisibilityConverter}}">
                        <TextBlock Text="{Binding CheckedCount, StringFormat='{}{0} selected'}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentTextBrush}"/>
                    </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:CountryCard CardData="{Binding Card}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                   IsEnabled="{Binding IsSelectable}" Opacity="{Binding IsSelectable, Converter={StaticResource BoolToOpacityConverter}}"
                                                   MouseLeftButtonUp="Target_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
