<Window x:Class="WC4SaveEditor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WC4SaveEditor.Gui.Views"
        xmlns:services="clr-namespace:WC4SaveEditor.Gui.Services"
        Title="WC4 Save Editor" Height="900" Width="1200" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppIcon.ico"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <DockPanel>
            <!-- Fixed top app bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush0}"
                    BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button DockPanel.Dock="Left" Content="&#8249;" Width="24" Height="28" Style="{StaticResource LinkButton}"
                                Click="ScrollLeft_Click" ToolTip="Scroll save file list left"/>
                        <Button DockPanel.Dock="Right" Content="&#8250;" Width="24" Height="28" Style="{StaticResource LinkButton}"
                                Click="ScrollRight_Click" ToolTip="Scroll save file list right" Margin="0,0,12,0"/>
                        <ScrollViewer x:Name="SaveFileScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding SaveFiles}" SelectedItem="{Binding SelectedSaveFile}"
                                     Style="{StaticResource SaveFileListBox}" ItemContainerStyle="{StaticResource SaveFileChip}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding Converter={StaticResource FileNameConverter}}"
                                                   ToolTip="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PendingCount, StringFormat='{}{0} pending'}" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"
                                ToolTip="Write every queued change to the save file (creates a .bak backup on first write)" Margin="0,0,8,0"/>
                        <Button Content="&#9881;" FontSize="16" Width="36" Height="36" Style="{StaticResource ButtonBase}"
                                Click="Settings_Click" ToolTip="Settings"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,48" MaxWidth="1000" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsDocumentLoaded}">
                    <views:QuickTogglesPanel DataContext="{Binding QuickToggles}"/>
                    <Border Style="{StaticResource HairlineDivider}"/>
                    <views:TeamPanel DataContext="{Binding TeamPanel}"/>
                    <Border Style="{StaticResource HairlineDivider}"/>
                    <views:ConquerPlayerPanel DataContext="{Binding ConquerPlayer}"/>
                    <Border Style="{StaticResource HairlineDivider}"/>
                    <views:ConquerProvincePanel DataContext="{Binding ConquerProvince}"/>
                    <Border Style="{StaticResource HairlineDivider}"/>
                    <views:SpawnUnitsPanel DataContext="{Binding SpawnUnits}"/>
                    <Border Style="{StaticResource HairlineDivider}"/>
                    <views:MapPanel DataContext="{Binding MapPanel}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Toast notifications overlay -->
        <ItemsControl ItemsSource="{x:Static services:NotificationCenter.Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" IsHitTestVisible="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="320" Margin="0,6,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                        <Setter Property="BorderBrush" Value="#6FAE7A"/>
                                        <Setter Property="Background" Value="#1A2B1E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter Property="BorderBrush" Value="#E0605A"/>
                                        <Setter Property="Background" Value="#2B1A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <TranslateTransform Y="12"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#10005;" Style="{StaticResource LinkButton}"
                                    Padding="4" Width="20" Height="20" VerticalAlignment="Top"
                                    Command="{Binding CloseCommand}"/>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource TextBody}" TextWrapping="Wrap"
                                       Margin="0,0,8,0"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
